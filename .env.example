# ---------------------------------------------------------------
# Security Bollard Direct — environment variables
# Copy to .env.local for local development, or run:
#   vercel env pull .env.local
# ---------------------------------------------------------------

# Canonical site URL. Set this first — sitemap, canonical tags and
# Open Graph all depend on it. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://securitybollarddirect.ca

# --- Neon Postgres (injected automatically by the Vercel integration) ---
# Pooled connection — used by the application.
DATABASE_URL=

# Direct connection — used by migrations only (drizzle-kit).
DATABASE_URL_UNPOOLED=

# --- Email notification (Resend) ---
# Without these the quote form still works; submissions are logged instead.
RESEND_API_KEY=
QUOTE_NOTIFICATION_EMAIL=info@securitybollarddirect.ca
QUOTE_FROM_EMAIL=quotes@securitybollarddirect.ca
